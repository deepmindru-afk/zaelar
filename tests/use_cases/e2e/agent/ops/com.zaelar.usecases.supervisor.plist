<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.zaelar.usecases.supervisor</string>

  <!-- Replace /path/to/zaelar/engine with your engine checkout before loading this agent.
       The wrapper brings the studios up and then ENTERS the loop with exec, so launchd watches
       the supervisor itself and not a parent shell that has already exited. -->
  <key>ProgramArguments</key>
  <array>
    <string>/path/to/zaelar/engine/tests/use_cases/e2e/agent/supervisor_24x7.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/path/to/zaelar/engine</string>

  <!-- This is "the cron that never stops": launchd starts it at login and restarts it every
       time it dies, for whatever reason. A `crontab` every N minutes would leave N-minute gaps
       and could overlap two supervisors on the ONE browser each studio has. -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <!-- Back-off for a start-up failure loop (broken venv, moved repo): without it launchd would
       retry hot and fill the disk with logs in minutes. -->
  <key>ThrottleInterval</key>
  <integer>60</integer>

  <key>StandardOutPath</key>
  <string>/path/to/zaelar/engine/tests/runs/use_cases/supervisor/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/path/to/zaelar/engine/tests/runs/use_cases/supervisor/launchd.err.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
